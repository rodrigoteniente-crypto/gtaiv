<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KickChaos.net</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.9.2.0</AssemblyVersion>
    <FileVersion>1.9.2.0</FileVersion>
    <Version>1.9.2-camera</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ScriptHookPath Condition="'$(ScriptHookPath)' == ''">/workspace/.onboarding/ScriptHookDotNet.dll</ScriptHookPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="ScriptHookDotNet"><HintPath>$(ScriptHookPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
